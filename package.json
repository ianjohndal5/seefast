{
  "name": "seefast",
  "version": "0.1.0",
  "description": "From a fresh clone to a running app: reads a project's own files (CI, containers, manifests, lockfiles, version files, env templates, README) and produces an evidence-backed setup plan, a machine check and a consent-driven runner. Offline, read-only, no AI.",
  "keywords": ["setup", "onboarding", "developer-experience", "doctor", "laravel", "nextjs", "monorepo", "offline"],
  "license": "MIT",
  "author": "ianjohndal <ianjohndal5@gmail.com>",
  "type": "module",
  "bin": { "seefast": "dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/core/schema.d.ts", "default": "./dist/core/schema.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "kb/*.json", "recipes/*.json", "CHANGELOG.md", "docs/PLAN-SCHEMA.md", "docs/DOCTOR.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seefast": "node dist/cli.js"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "semver": "7.7.3",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/semver": "7.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
